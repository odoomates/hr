<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- the batch of the month of the companies with Monthly Batch on: checked each day, created once a month -->
    <record id="ir_cron_monthly_batch" model="ir.cron">
        <field name="name">Payroll: Monthly Batch</field>
        <field name="model_id" ref="model_hr_payslip_run"/>
        <field name="state">code</field>
        <field name="code">model._cron_monthly_batch()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>

</odoo>
