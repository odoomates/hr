<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="0">

        <record id="hr_rule_basic" model="hr.salary.rule">
            <field name="name">Basic Salary</field>
            <field name="sequence" eval="1"/>
            <field name="code">BASIC</field>
            <field name="category_id" ref="om_hr_payroll.BASIC"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = contract.wage</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="hr_rule_taxable" model="hr.salary.rule">
            <field name="name">Gross</field>
            <field name="sequence" eval="100"/>
            <field name="code">GROSS</field>
            <field name="category_id" ref="om_hr_payroll.GROSS"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = categories.BASIC + categories.ALW</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="hr_rule_unpaid_leave" model="hr.salary.rule">
            <field name="name">Unpaid Time Off</field>
            <field name="sequence" eval="2"/>
            <field name="code">UNPAID</field>
            <field name="category_id" ref="om_hr_payroll.BASIC"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"># the part of the period the time off is not paid at, which is negative
result = contract.wage * worked_days.unpaid_ratio()</field>
            <field name="note">Takes off the wage of the days of time off that are not paid. How much of a
time off is paid comes from the rate of its Time Type: 100% for a time off paid in full, 0% for an unpaid
one, 50% for a time off paid at half. The rule belongs to the Basic category, so that the gross of the
payslip is the pay actually earned in the period.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="hr_rule_partial_period" model="hr.salary.rule">
            <field name="name">Partial Period</field>
            <field name="sequence" eval="2"/>
            <field name="code">PARTIAL</field>
            <field name="category_id" ref="om_hr_payroll.BASIC"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = worked_days.prorata() &lt; 1</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"># the part of the period outside the contract, which is negative
result = -contract.wage * (1 - worked_days.prorata())</field>
            <field name="note">Takes off the wage of the working days of the pay period outside the contract: before
the employee joined or after they left. A monthly wage is measured against the calendar month. The rule belongs to
the Basic category, so that the gross of the payslip is the pay actually earned in the period.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="hr_rule_attendance_adjustment" model="hr.salary.rule">
            <field name="name">Attendance Adjustment</field>
            <field name="sequence" eval="3"/>
            <field name="code">ATTADJ</field>
            <field name="category_id" ref="om_hr_payroll.BASIC"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = contract.wage_type == 'monthly' and worked_days.missing_hours() > 0 and worked_days.scheduled_hours() > 0</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"># the hours due neither worked nor on time off, for a contract based on attendances
result = -contract.wage * worked_days.missing_hours() / worked_days.scheduled_hours()</field>
            <field name="note">For a fixed wage paid on attendances: takes off the wage of the hours the employee was due
to work but neither worked nor took as time off. The time off is taken off by the Unpaid Time Off rule.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="hr_rule_hourly" model="hr.salary.rule">
            <field name="name">Hourly Pay</field>
            <field name="sequence" eval="1"/>
            <field name="code">HOURLY</field>
            <field name="category_id" ref="om_hr_payroll.BASIC"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = contract.wage_type == 'hourly'</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"># the hours worked, and the time off at its paid rate, times the hourly wage
result = contract.hourly_wage * worked_days.paid_hours()</field>
            <field name="note">For an hourly wage: pays the hours worked, or attended for a contract based on attendances,
and the hours of time off at the paid rate of their time type. The overtime is paid by the Overtime rule.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="hr_rule_retro" model="hr.salary.rule">
            <field name="name">Retro Pay</field>
            <field name="sequence" eval="55"/>
            <field name="code">RETRO</field>
            <field name="category_id" ref="om_hr_payroll.ALW"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = bool(inputs.RETRO.amount)</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = inputs.RETRO.amount</field>
            <field name="note">Pays the difference the Retro Pay action of the payslip has found on the payslips
already confirmed, e.g. after a raise dated back to a past month. It is negative for a cut.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="hr_rule_retro_input" model="hr.rule.input">
            <field name="name">Retro Pay</field>
            <field name="code">RETRO</field>
            <field name="input_id" ref="hr_rule_retro"/>
        </record>

        <record id="hr_rule_allowances" model="hr.salary.rule">
            <field name="name">Allowances</field>
            <field name="sequence" eval="50"/>
            <field name="code">ALW</field>
            <field name="category_id" ref="om_hr_payroll.ALW"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"># what the contract of the employee pays besides the wage
result = sum(line.amount for line in contract.salary_component_ids
             if line.component_id.category_id.code == 'ALW')</field>
            <field name="note">Pays every salary component of the contract that belongs to the Allowance
category. Replace it with a rule per component, e.g. result = components.HOUSING, when each one has to
appear on its own line of the payslip.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="hr_rule_deductions" model="hr.salary.rule">
            <field name="name">Deductions</field>
            <field name="sequence" eval="60"/>
            <field name="code">DED</field>
            <field name="category_id" ref="om_hr_payroll.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"># the amounts are held positive on the contract and deducted here
result = -sum(line.amount for line in contract.salary_component_ids
              if line.component_id.category_id.code == 'DED')</field>
            <field name="note">Deducts every salary component of the contract that belongs to the Deduction
category. The amounts are entered positive on the contract.</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="hr_rule_net" model="hr.salary.rule">
            <field name="name">Net Salary</field>
            <field name="sequence" eval="200"/>
            <field name="code">NET</field>
            <field name="category_id" ref="om_hr_payroll.NET"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = categories.BASIC + categories.ALW + categories.DED</field>
            <field name="register_id" ref="contrib_register_employees"/>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Decimal Precision -->

        <record forcecreate="True" id="decimal_payroll" model="decimal.precision">
            <field name="name">Payroll</field>
            <field name="digits">2</field>
        </record>

        <record forcecreate="True" id="decimal_payroll_rate" model="decimal.precision">
            <field name="name">Payroll Rate</field>
            <field name="digits">4</field>
        </record>

    </data>

    <!-- The structure belongs to whoever installed the module: the rules it applies are only set when it is
         created, so that an update never drops the rules added to it, nor adds rules paying twice what the
         rules of the user already pay. -->
    <data noupdate="1">

        <record id="structure_base" model="hr.payroll.structure">
            <field name="code">BASE</field>
            <field name="name">Base for new structures</field>
            <field name="rule_ids" eval="[(6, 0, [
                ref('hr_rule_basic'),
                ref('hr_rule_hourly'),
                ref('hr_rule_unpaid_leave'),
                ref('hr_rule_attendance_adjustment'),
                ref('hr_rule_partial_period'),
                ref('hr_rule_allowances'),
                ref('hr_rule_retro'),
                ref('hr_rule_deductions'),
                ref('hr_rule_taxable'),
                ref('hr_rule_net'),
            ])]"/>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
