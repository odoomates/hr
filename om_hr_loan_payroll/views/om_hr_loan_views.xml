<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="om_hr_loan_view_form" model="ir.ui.view">
        <field name="name">hr.loan.view.form.payroll</field>
        <field name="model">hr.loan</field>
        <field name="inherit_id" ref="om_hr_loan.om_hr_loan_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/list/field[@name='date_paid']" position="after">
                <field name="payslip_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="om_hr_loan_line_view_list" model="ir.ui.view">
        <field name="name">hr.loan.line.view.list.payroll</field>
        <field name="model">hr.loan.line</field>
        <field name="inherit_id" ref="om_hr_loan.om_hr_loan_line_view_list"/>
        <field name="arch" type="xml">
            <field name="date_paid" position="after">
                <field name="payslip_id" optional="show"/>
            </field>
        </field>
    </record>

</odoo>
