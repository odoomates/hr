<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="hr_rule_loan" model="hr.salary.rule">
            <field name="name">Loan Installments</field>
            <field name="sequence" eval="65"/>
            <field name="code">LOAN</field>
            <field name="category_id" ref="om_hr_payroll.DED"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = bool(inputs.LOAN.amount)</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"># the installments due, filled in by the loans when the payslip is computed
result = -inputs.LOAN.amount</field>
            <field name="input_ids" eval="[(0, 0, {'name': 'Loan Installments', 'code': 'LOAN'})]"/>
            <field name="note">Deducts the loan installments due by the end of the period. Add the rule to the
salary structures deducting the loans.</field>
            <field name="company_id" eval="False"/>
        </record>

        <function model="hr.salary.rule" name="_om_hr_loan_add_to_base_structure"/>

    </data>
</odoo>
