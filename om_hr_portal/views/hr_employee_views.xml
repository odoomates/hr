<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_view_form_om_portal" model="ir.ui.view">
        <field name="name">hr.employee.view.form.om.portal</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_grant_portal" string="Grant Portal Access" type="object"
                        invisible="user_id" groups="hr.group_hr_user"
                        confirm="An invitation to the HR pages of the website will be sent to the email of the employee. Continue?"/>
            </xpath>
        </field>
    </record>

</odoo>
