<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="mail_preboarding_welcome" name="Pre-boarding Welcome Email">
        <div>
            <p>Hello <t t-out="preboarding.employee_id.name"/>,</p>
            <p>Welcome to <strong t-out="preboarding.company_id.name"/>! Your first day is
                <t t-out="preboarding.date_start"/>.</p>
            <p>Before then, a few steps get you ready: your details for HR, and what to know for your first day.</p>
            <p style="margin: 24px 0;">
                <a t-att-href="url"
                   style="background-color: #00796b; color: #ffffff; padding: 10px 18px; text-decoration: none; border-radius: 4px;">
                    Get Ready
                </a>
            </p>
            <p style="color: #6c757d; font-size: 12px;">If you have no password yet, use the invitation email you
                received to set it first.</p>
        </div>
    </template>

    <template id="portal_my_hr" inherit_id="om_hr_portal.portal_my_hr" name="My HR: Welcome">
        <xpath expr="//div[@id='om_hr_cards']" position="inside">
            <div t-if="employee.preboarding_ids.filtered(lambda p: p.state == 'running')" class="col" style="order: -1;">
                <t t-call="om_hr_portal.portal_my_hr_card" url="'/my/welcome'" icon="'task'"
                   title.translate="Welcome" text.translate="Get ready for your first day"/>
            </div>
        </xpath>
    </template>

    <template id="portal_my_welcome" name="Pre-boarding">
        <t t-call="portal.portal_layout">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="mb-0">Welcome, <t t-out="preboarding.employee_id.name"/></h3>
                <span class="text-muted">First day: <t t-out="preboarding.date_start"/></span>
            </div>
            <div class="progress mb-4" style="height: 8px;" role="progressbar" t-att-aria-valuenow="preboarding.progress">
                <div class="progress-bar bg-success" t-attf-style="width: #{preboarding.progress}%;"/>
            </div>
            <div t-if="preboarding.state == 'done'" class="alert alert-success">You are all set: see you soon!</div>
            <div t-elif="preboarding.state == 'closed'" class="alert alert-info">Your pre-boarding is closed.</div>
            <div class="row g-4">
                <div class="col-lg-7">
                    <div class="list-group">
                        <a t-foreach="preboarding.line_ids" t-as="line" t-attf-href="/my/welcome/#{line.id}"
                           class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <span t-attf-class="#{'fw-bold' if line.state in ('todo', 'returned') else ''}" t-out="line.name"/>
                            <span>
                                <span t-if="line.state == 'done'" class="badge text-bg-success">Done</span>
                                <span t-elif="line.state == 'submitted'" class="badge text-bg-info">With HR</span>
                                <span t-elif="line.state == 'returned'" class="badge text-bg-warning">To Correct</span>
                                <span t-else="" class="badge text-bg-secondary">To Do</span>
                            </span>
                        </a>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="card mb-3">
                        <div class="card-body">
                            <h5 class="card-title">Your First Day</h5>
                            <div t-field="preboarding.welcome"/>
                        </div>
                    </div>
                    <div t-if="preboarding.buddy_id" class="card">
                        <div class="card-body d-flex gap-3 align-items-center">
                            <img t-if="preboarding.buddy_id.image_128" t-att-src="image_data_uri(preboarding.buddy_id.image_128)"
                                 class="rounded-circle" style="width: 48px; height: 48px; object-fit: cover;" alt="Buddy"/>
                            <div>
                                <div class="text-muted small">Your buddy</div>
                                <strong t-out="preboarding.buddy_id.name"/>
                                <div class="small" t-out="preboarding.buddy_id.job_title or ''"/>
                                <div class="small" t-out="preboarding.buddy_id.work_email or ''"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="portal_my_welcome_step" name="Pre-boarding Step">
        <t t-call="portal.portal_layout">
            <div class="card">
                <div class="card-header"><h4 class="mb-0" t-out="line.name"/></div>
                <div class="card-body">
                    <div t-if="error" class="alert alert-danger" t-out="error"/>
                    <div t-if="line.state == 'returned' and line.review_note" class="alert alert-warning">
                        <strong>HR asks you to correct:</strong> <span t-out="line.review_note"/>
                    </div>
                    <div t-if="line.description" t-field="line.description" class="mb-3"/>
                    <t t-set="editable" t-value="preboarding.state == 'running' and line.state in ('todo', 'returned')"/>
                    <div id="preboarding_auto_step" t-if="editable and auto"/>
                    <form t-if="editable and not auto" t-attf-action="/my/welcome/#{line.id}" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div t-foreach="inputs" t-as="item" class="mb-3">
                            <t t-set="value" t-value="(posted or {}).get(item['name'], item['value'])"/>
                            <label class="form-label" t-att-for="item['name']" t-out="item['label']"/>
                            <select t-if="item.get('options')" class="form-select" t-att-id="item['name']" t-att-name="item['name']">
                                <option value=""/>
                                <option t-foreach="item['options']" t-as="option" t-att-value="option[0]"
                                        t-att-selected="str(option[0]) == str(value or '')" t-out="option[1]"/>
                            </select>
                            <input t-else="" class="form-control" t-att-id="item['name']" t-att-name="item['name']"
                                   t-att-type="'date' if item['type'] == 'date' else 'number' if item['type'] == 'integer' else 'text'"
                                   t-att-value="value or ''"/>
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <t t-if="inputs">Send to HR</t>
                            <t t-elif="line.kind == 'read'">I Have Read It</t>
                            <t t-else="">Done</t>
                        </button>
                    </form>
                    <p t-elif="line.state == 'submitted'" class="text-muted mb-0">HR is checking what you gave.</p>
                    <p t-elif="line.state == 'done'" class="text-success mb-0">Done.</p>
                </div>
            </div>
        </t>
    </template>

</odoo>
