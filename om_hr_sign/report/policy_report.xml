<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- a policy written as text, printed to be signed -->
    <record id="action_report_policy_version" model="ir.actions.report">
        <field name="name">Policy</field>
        <field name="model">hr.policy.version</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">om_hr_sign.report_policy_version</field>
        <field name="print_report_name">object.name</field>
    </record>

    <template id="report_policy_version">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h3 t-out="o.policy_id.name"/>
                        <p class="text-muted">
                            Version <t t-out="o.number"/>
                            <t t-if="o.date_published">, published on <t t-out="o.date_published.date()"/></t>
                        </p>
                        <div t-field="o.body"/>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
