<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_hr" inherit_id="om_hr_portal.portal_my_hr" name="My HR: Payslips">
        <xpath expr="//div[@id='om_hr_cards']" position="inside">
            <div class="col" style="order: 1;">
                <t t-call="om_hr_portal.portal_my_hr_card" url="'/my/hr/payslips'" icon="'payments'"
                   title.translate="Payslips" text.translate="Your payslips, to read and download"/>
            </div>
        </xpath>
    </template>

    <template id="portal_my_payslips" name="My Payslips">
        <t t-call="portal.portal_layout">
            <t t-if="not payslips">
                <div class="alert alert-info" role="status">No payslip yet: they show here once confirmed.</div>
            </t>
            <t t-else="" t-call="portal.portal_table">
                <thead>
                    <tr>
                        <th>Payslip</th>
                        <th>Period</th>
                        <th class="text-end">Net</th>
                        <th class="text-end"/>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="payslips" t-as="payslip">
                        <td><a t-attf-href="/my/hr/payslips/#{payslip.id}" t-out="payslip.name"/></td>
                        <td><span t-field="payslip.date_from"/> - <span t-field="payslip.date_to"/></td>
                        <td class="text-end">
                            <span t-out="sum(payslip.line_ids.filtered(lambda line: line.code == 'NET').mapped('total'))"
                                  t-options="{'widget': 'monetary', 'display_currency': payslip.company_id.currency_id}"/>
                        </td>
                        <td class="text-end">
                            <a t-attf-href="/my/payslip/#{payslip.id}/pdf" class="btn btn-sm btn-secondary">
                                <i class="oi" data-icon="download" title="Download"/> PDF
                            </a>
                        </td>
                    </tr>
                </tbody>
            </t>
            <div t-if="statement_years" class="mt-4">
                <h5>Annual Statements</h5>
                <p class="text-muted small">What you were paid over each payroll year, month by month.</p>
                <a t-foreach="statement_years" t-as="year" t-attf-href="/my/payslip/statement/#{year[0]}"
                   class="btn btn-sm btn-secondary me-2 mb-2">
                    <i class="oi" data-icon="download" title="Download"/> <t t-out="year[1]"/>
                </a>
            </div>
        </t>
    </template>

    <template id="portal_my_payslip" name="My Payslip">
        <t t-call="portal.portal_layout">
            <div class="card">
                <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div>
                        <h4 class="mb-0" t-out="payslip.name"/>
                        <small class="text-muted"><span t-field="payslip.date_from"/> - <span t-field="payslip.date_to"/></small>
                    </div>
                    <a t-attf-href="/my/payslip/#{payslip.id}/pdf" class="btn btn-primary">
                        <i class="oi" data-icon="download" title="Download"/> Download PDF
                    </a>
                </div>
                <div class="card-body p-0">
                    <table class="table mb-0">
                        <tbody>
                            <tr t-foreach="payslip.line_ids.filtered('appears_on_payslip')" t-as="line"
                                t-att-class="'fw-bold' if line.code == 'NET' else None">
                                <td t-out="line.name"/>
                                <td class="text-end">
                                    <span t-out="line.total" t-options="{'widget': 'monetary', 'display_currency': payslip.company_id.currency_id}"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>

</odoo>
