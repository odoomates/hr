<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_version_view_form" model="ir.ui.view">
        <field name="name">hr.version.view.form.om_hr_base</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_contract_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='job_id']" position="after">
                <field name="type_id" required="1"/>
            </xpath>
        </field>
    </record>

    <menuitem id="menu_contract_type"
              action="hr.hr_contract_type_action"
              parent="hr.menu_human_resources_configuration"
              sequence="3"
              groups="base.group_no_one"/>

</odoo>
