<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="om_hr_appraisal_template_view_list" model="ir.ui.view">
        <field name="name">hr.appraisal.template.view.list</field>
        <field name="model">hr.appraisal.template</field>
        <field name="arch" type="xml">
            <list string="Feedback Templates">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="department_ids" widget="many2many_tags"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="om_hr_appraisal_template_view_form" model="ir.ui.view">
        <field name="name">hr.appraisal.template.view.form</field>
        <field name="model">hr.appraisal.template</field>
        <field name="arch" type="xml">
            <form string="Feedback Template">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Sales Team"/></h1>
                    </div>
                    <group>
                        <field name="department_ids" widget="many2many_tags"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Employee's Feedback" name="employee">
                            <field name="employee_feedback" class="oe-bordered-editor"/>
                        </page>
                        <page string="Manager's Feedback" name="manager">
                            <field name="manager_feedback" class="oe-bordered-editor"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="om_hr_appraisal_template_action" model="ir.actions.act_window">
        <field name="name">Feedback Templates</field>
        <field name="res_model">hr.appraisal.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="om_hr_appraisal_rating_view_list" model="ir.ui.view">
        <field name="name">hr.appraisal.rating.view.list</field>
        <field name="model">hr.appraisal.rating</field>
        <field name="arch" type="xml">
            <list string="Ratings" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="performance_level" groups="om_hr_appraisal.group_calibration"/>
            </list>
        </field>
    </record>

    <record id="om_hr_appraisal_rating_action" model="ir.actions.act_window">
        <field name="name">Ratings</field>
        <field name="res_model">hr.appraisal.rating</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
