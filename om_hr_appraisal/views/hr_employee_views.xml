<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_employee_view_form_om_appraisal" model="ir.ui.view">
        <field name="name">hr.employee.view.form.om.appraisal</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_om_appraisals" type="object" class="oe_stat_button" icon="star"
                        groups="hr.group_hr_user">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="om_appraisal_count"/></span>
                        <span class="o_stat_text">Appraisals</span>
                        <span class="o_stat_text text-muted" invisible="not om_next_appraisal_date">
                            next <field name="om_next_appraisal_date" widget="date"/>
                        </span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>

</odoo>
