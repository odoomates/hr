<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_one_on_one_view_form" model="ir.ui.view">
        <field name="name">hr.one.on.one.view.form</field>
        <field name="model">hr.one.on.one</field>
        <field name="arch" type="xml">
            <form string="One-on-One">
                <header>
                    <button name="action_done" string="Mark as Done" type="object" class="btn-primary"
                            invisible="state != 'planned' or not is_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state != 'planned' or not is_manager"/>
                    <button name="action_plan" string="Plan Again" type="object"
                            invisible="state != 'cancel' or not is_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,done"/>
                </header>
                <sheet>
                    <field name="is_manager" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" widget="many2one_avatar_employee" readonly="not is_manager"/>
                            <field name="manager_id" widget="many2one_avatar_employee" readonly="not is_manager"/>
                            <field name="appraisal_id" readonly="not is_manager" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="date" readonly="not is_manager"/>
                            <label for="repeat_weeks"/>
                            <div class="o_row" name="repeat">
                                <field name="repeat_weeks" class="oe_inline" readonly="not is_manager"/> weeks
                            </div>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Shared Notes" name="notes">
                            <field name="notes" placeholder="What you talk about, for both of you"
                                   readonly="state == 'cancel'"/>
                        </page>
                        <page string="Private Notes" name="manager_note" invisible="not is_manager">
                            <field name="manager_note" placeholder="For you and HR only: the employee never reads them"/>
                        </page>
                        <page string="Actions" name="actions">
                            <field name="action_ids" readonly="not is_manager">
                                <list editable="bottom">
                                    <field name="done" widget="boolean_toggle"/>
                                    <field name="name"/>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="date_deadline"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_one_on_one_view_list" model="ir.ui.view">
        <field name="name">hr.one.on.one.view.list</field>
        <field name="model">hr.one.on.one</field>
        <field name="arch" type="xml">
            <list string="One-on-Ones" decoration-muted="state == 'cancel'">
                <field name="date"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="manager_id" widget="many2one_avatar_employee" optional="show"/>
                <field name="repeat_weeks" optional="hide"/>
                <field name="appraisal_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'planned'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="hr_one_on_one_view_calendar" model="ir.ui.view">
        <field name="name">hr.one.on.one.view.calendar</field>
        <field name="model">hr.one.on.one</field>
        <field name="arch" type="xml">
            <calendar string="One-on-Ones" date_start="date" mode="week" color="employee_id" quick_create="0">
                <field name="employee_id"/>
                <field name="manager_id"/>
            </calendar>
        </field>
    </record>

    <record id="hr_one_on_one_view_search" model="ir.ui.view">
        <field name="name">hr.one.on.one.view.search</field>
        <field name="model">hr.one.on.one</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="manager_id"/>
                <filter name="mine" string="Mine" domain="[('employee_id.user_id', '=', uid)]"/>
                <filter name="my_team" string="My Team" domain="[('manager_id.user_id', '=', uid)]"/>
                <separator/>
                <filter name="planned" string="Planned" domain="[('state', '=', 'planned')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hr_one_on_one_action" model="ir.actions.act_window">
        <field name="name">One-on-Ones</field>
        <field name="res_model">hr.one.on.one</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'search_default_my_team': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Plan a one-on-one</p>
            <p>A regular talk with each person of your team: shared notes, your private notes and the actions
                you agree on, which become to-dos.</p>
        </field>
    </record>

    <record id="hr_one_on_one_action_my" model="ir.actions.act_window">
        <field name="name">My One-on-Ones</field>
        <field name="res_model">hr.one.on.one</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No one-on-one yet</p>
            <p>Your manager plans them; you both write the shared notes.</p>
        </field>
    </record>

</odoo>
