<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="om_hr_appraisal_goal_view_form" model="ir.ui.view">
        <field name="name">hr.appraisal.goal.view.form</field>
        <field name="model">hr.appraisal.goal</field>
        <field name="arch" type="xml">
            <form string="Goal">
                <sheet>
                    <widget name="web_ribbon" title="Reached" bg_color="text-bg-success" invisible="not is_done"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Learn the new payroll rules"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="level" widget="radio" options="{'horizontal': true}"
                                   groups="om_hr_appraisal.group_goal_alignment"/>
                            <field name="employee_id" widget="many2one_avatar_employee"
                                   invisible="level != 'employee'" required="level == 'employee'"/>
                            <field name="manager_id" widget="many2one_avatar_employee" invisible="level != 'employee'"/>
                            <field name="department_id" invisible="level == 'company'"
                                   readonly="level == 'employee'" required="level == 'department'"
                                   groups="om_hr_appraisal.group_goal_alignment"/>
                            <field name="parent_id" groups="om_hr_appraisal.group_goal_alignment"
                                   options="{'no_create': True}"/>
                            <field name="appraisal_id" invisible="level != 'employee'"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="level != 'company'" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="target"/>
                            <field name="date_deadline"/>
                            <field name="progress" widget="progressbar" options="{'editable': true}"
                                   readonly="has_children"/>
                            <field name="is_done" invisible="1"/>
                            <field name="has_children" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Describe the goal"/>
                        </page>
                        <page string="Served By" name="children" invisible="not has_children"
                              groups="om_hr_appraisal.group_goal_alignment">
                            <field name="child_ids" readonly="1">
                                <list>
                                    <field name="level"/>
                                    <field name="name"/>
                                    <field name="employee_id" widget="many2one_avatar_employee"/>
                                    <field name="department_id"/>
                                    <field name="progress" widget="progressbar"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="om_hr_appraisal_goal_view_list" model="ir.ui.view">
        <field name="name">hr.appraisal.goal.view.list</field>
        <field name="model">hr.appraisal.goal</field>
        <field name="arch" type="xml">
            <list string="Goals" decoration-success="is_done">
                <field name="level" groups="om_hr_appraisal.group_goal_alignment" optional="show"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="department_id" groups="om_hr_appraisal.group_goal_alignment" optional="hide"/>
                <field name="name"/>
                <field name="parent_id" groups="om_hr_appraisal.group_goal_alignment" optional="show"/>
                <field name="target" optional="show"/>
                <field name="date_deadline" widget="remaining_days" invisible="is_done"/>
                <field name="progress" widget="progressbar"/>
                <field name="is_done" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="om_hr_appraisal_goal_view_search" model="ir.ui.view">
        <field name="name">hr.appraisal.goal.view.search</field>
        <field name="model">hr.appraisal.goal</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <filter name="mine" string="My Goals" domain="[('employee_id.user_id', '=', uid)]"/>
                <filter name="my_team" string="My Team" domain="[('employee_id.parent_id.user_id', '=', uid)]"/>
                <separator/>
                <filter name="open" string="In Progress" domain="[('is_done', '=', False)]"/>
                <filter name="reached" string="Reached" domain="[('is_done', '=', True)]"/>
                <filter name="shared" string="Company and Department Goals"
                        domain="[('level', 'in', ('company', 'department'))]"
                        groups="om_hr_appraisal.group_goal_alignment"/>
                <field name="department_id" groups="om_hr_appraisal.group_goal_alignment"/>
                <field name="parent_id" string="Serving" filter_domain="[('parent_id', 'child_of', raw_value)]"
                       groups="om_hr_appraisal.group_goal_alignment"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_level" string="Level" context="{'group_by': 'level'}"
                            groups="om_hr_appraisal.group_goal_alignment"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"
                            groups="om_hr_appraisal.group_goal_alignment"/>
                </group>
            </search>
        </field>
    </record>

    <record id="om_hr_appraisal_goal_view_hierarchy" model="ir.ui.view">
        <field name="name">hr.appraisal.goal.view.hierarchy</field>
        <field name="model">hr.appraisal.goal</field>
        <field name="arch" type="xml">
            <hierarchy child_field="child_ids" draggable="1">
                <field name="name"/>
                <field name="level"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="progress"/>
                <templates>
                    <t t-name="hierarchy-box">
                        <div class="d-flex flex-column gap-1 p-2 text-center">
                            <field name="level" class="small text-muted"/>
                            <field name="name" class="fw-bold"/>
                            <field name="employee_id" class="text-muted" invisible="level != 'employee'"/>
                            <field name="department_id" class="text-muted" invisible="level != 'department'"/>
                            <field name="progress" widget="progressbar"/>
                        </div>
                    </t>
                </templates>
            </hierarchy>
        </field>
    </record>

    <record id="om_hr_appraisal_goal_action_alignment" model="ir.actions.act_window">
        <field name="name">Goal Alignment</field>
        <field name="res_model">hr.appraisal.goal</field>
        <field name="view_mode">hierarchy,list,form</field>
        <field name="context">{'default_level': 'company', 'search_default_shared': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set a goal of the company</p>
            <p>Then the goals of the departments serving it, and the goals of the employees serving those: the
                progress of each goal is the average of the goals serving it.</p>
        </field>
    </record>

    <record id="om_hr_appraisal_goal_action" model="ir.actions.act_window">
        <field name="name">Goals</field>
        <field name="res_model">hr.appraisal.goal</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set a goal</p>
            <p>What an employee aims at until the next appraisal; they update its progress themselves.</p>
        </field>
    </record>

</odoo>
