<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="om_hr_appraisal_cycle_view_form" model="ir.ui.view">
        <field name="name">hr.appraisal.cycle.view.form</field>
        <field name="model">hr.appraisal.cycle</field>
        <field name="arch" type="xml">
            <form string="Appraisal Cycle">
                <header>
                    <button name="action_generate" string="Generate Appraisals" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_generate" string="Add New Employees" type="object"
                            invisible="state != 'running'"/>
                    <button name="action_close" string="Close" type="object" invisible="state != 'running'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_appraisals" type="object" class="oe_stat_button" icon="groups">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="done_count"/> / <field name="appraisal_count"/></span>
                                <span class="o_stat_text">Done</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Annual Review 2026"/></h1>
                    </div>
                    <group>
                        <group>
                            <label for="date_start" string="Period"/>
                            <div class="o_row">
                                <field name="date_start"/> <span>to</span> <field name="date_end"/>
                            </div>
                            <field name="date_deadline"/>
                            <field name="template_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="progress" widget="progressbar" invisible="state == 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Who Takes Part">
                        <field name="department_ids" widget="many2many_tags"/>
                        <field name="employee_ids" widget="many2many_avatar_employee"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="om_hr_appraisal_cycle_view_list" model="ir.ui.view">
        <field name="name">hr.appraisal.cycle.view.list</field>
        <field name="model">hr.appraisal.cycle</field>
        <field name="arch" type="xml">
            <list string="Appraisal Cycles">
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="date_deadline"/>
                <field name="appraisal_count" string="Appraisals"/>
                <field name="progress" widget="progressbar"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'running'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="om_hr_appraisal_cycle_action" model="ir.actions.act_window">
        <field name="name">Cycles</field>
        <field name="res_model">hr.appraisal.cycle</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Run a review cycle</p>
            <p>The annual review of a department or of the whole company: one appraisal for each employee.</p>
        </field>
    </record>

</odoo>
