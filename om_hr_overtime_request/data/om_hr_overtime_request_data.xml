<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="flow_overtime_request" model="approval.rule">
            <field name="name">Overtime Requests</field>
            <field name="model_id" ref="om_hr_overtime_request.model_hr_overtime_request"/>
            <field name="fallback_group_id" ref="hr_attendance.group_hr_attendance_user"/>
            <field name="self_approve" eval="True"/>
        </record>

        <record id="flow_overtime_request_manager" model="approval.step">
            <field name="flow_id" ref="flow_overtime_request"/>
            <field name="sequence">10</field>
            <field name="name">Manager</field>
            <field name="approver_type">manager</field>
        </record>

    </data>
</odoo>
