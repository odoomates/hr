<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="hr_rule_leave_encashment" model="hr.salary.rule">
            <field name="name">Unused Time Off</field>
            <field name="sequence" eval="55"/>
            <field name="code">LEAVE_ENCASH</field>
            <field name="category_id" ref="om_hr_payroll.ALW"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = bool(inputs.LEAVE_ENCASH.amount)</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"># the time off left at the exit, filled in by the final settlement
result = inputs.LEAVE_ENCASH.amount</field>
            <field name="input_ids" eval="[(0, 0, {'name': 'Unused Time Off', 'code': 'LEAVE_ENCASH'})]"/>
            <field name="company_id" eval="False"/>
        </record>

        <record id="hr_rule_gratuity" model="hr.salary.rule">
            <field name="name">End of Service Gratuity</field>
            <field name="sequence" eval="56"/>
            <field name="code">GRATUITY</field>
            <field name="category_id" ref="om_hr_payroll.ALW"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = bool(inputs.GRATUITY.amount)</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"># computed on the exit, filled in by the final settlement
result = inputs.GRATUITY.amount</field>
            <field name="input_ids" eval="[(0, 0, {'name': 'End of Service Gratuity', 'code': 'GRATUITY'})]"/>
            <field name="company_id" eval="False"/>
        </record>

        <function model="hr.salary.rule" name="_om_hr_exit_add_to_base_structure"/>

    </data>
</odoo>
