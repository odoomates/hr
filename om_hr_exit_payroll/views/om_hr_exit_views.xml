<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="om_hr_exit_view_form" model="ir.ui.view">
        <field name="name">hr.exit.view.form.payroll</field>
        <field name="model">hr.exit</field>
        <field name="inherit_id" ref="om_hr_exit.om_hr_exit_view_form"/>
        <field name="arch" type="xml">
            <button name="action_done" position="before">
                <button name="action_final_settlement" string="Final Settlement" type="object"
                        invisible="state not in ('approved', 'done') or settlement_payslip_id"
                        groups="om_hr_payroll.group_hr_payroll_user"/>
            </button>
            <xpath expr="//sheet/div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box" groups="hr.group_hr_user"
                     invisible="not settlement_payslip_id">
                    <button name="action_open_settlement" type="object" class="oe_stat_button" icon="payments">
                        <div class="o_stat_info">
                            <span class="o_stat_text">Final</span>
                            <span class="o_stat_text">Settlement</span>
                        </div>
                    </button>
                </div>
            </xpath>
            <field name="departure_id" position="after">
                <field name="settlement_payslip_id" invisible="1"/>
                <field name="encashment_days" invisible="state not in ('approved', 'done')"
                       groups="hr.group_hr_user"/>
                <field name="encashment_amount" invisible="state not in ('approved', 'done')"
                       groups="hr.group_hr_user"/>
            </field>
        </field>
    </record>

</odoo>
