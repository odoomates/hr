<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="hr_rule_asset" model="hr.salary.rule">
            <field name="name">Asset Charges</field>
            <field name="sequence" eval="66"/>
            <field name="code">ASSET</field>
            <field name="category_id" ref="om_hr_payroll.DED"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = bool(inputs.ASSET.amount)</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute"># the charges for the assets lost or damaged, filled in when the payslip is computed
result = -inputs.ASSET.amount</field>
            <field name="input_ids" eval="[(0, 0, {'name': 'Asset Charges', 'code': 'ASSET'})]"/>
            <field name="note">Deducts what the employee is charged for the assets returned damaged or reported
lost. Add the rule to the salary structures deducting them.</field>
            <field name="company_id" eval="False"/>
        </record>

        <function model="hr.salary.rule" name="_hr_asset_add_to_base_structure"/>

    </data>
</odoo>
