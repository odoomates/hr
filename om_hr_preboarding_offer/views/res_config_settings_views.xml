<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.om_hr_preboarding_offer</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="om_hr_preboarding.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="om_hr_preboarding_setting_container" position="inside">
                <setting company_dependent="1" id="preboarding_from_offer_setting" string="Start From Accepted Offers"
                         help="The employee created from an accepted job offer starts their pre-boarding">
                    <field name="preboarding_from_offer"/>
                </setting>
            </block>
        </field>
    </record>

</odoo>
