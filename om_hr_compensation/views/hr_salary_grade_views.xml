<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_salary_grade_view_form" model="ir.ui.view">
        <field name="name">hr.salary.grade.view.form</field>
        <field name="model">hr.salary.grade</field>
        <field name="arch" type="xml">
            <form string="Salary Grade">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. G5"/></h1>
                    </div>
                    <group>
                        <group string="Monthly Wage Band">
                            <field name="currency_id" invisible="1"/>
                            <field name="wage_min"/>
                            <field name="wage_mid"/>
                            <field name="wage_max"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Job Positions" name="jobs">
                            <field name="job_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="department_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="What the grade covers"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_salary_grade_view_list" model="ir.ui.view">
        <field name="name">hr.salary.grade.view.list</field>
        <field name="model">hr.salary.grade</field>
        <field name="arch" type="xml">
            <list string="Salary Grades">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="wage_min"/>
                <field name="wage_mid"/>
                <field name="wage_max"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="hr_salary_grade_action" model="ir.actions.act_window">
        <field name="name">Salary Grades</field>
        <field name="res_model">hr.salary.grade</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set your salary grades</p>
            <p>The band of monthly wages of each grade, from its minimum to its maximum; the job positions point to
                their grade, and each wage gets its compa-ratio.</p>
        </field>
    </record>

    <record id="hr_job_view_form" model="ir.ui.view">
        <field name="name">hr.job.view.form.compensation</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <field name="department_id" position="after">
                <field name="salary_grade_id" groups="hr.group_hr_user" options="{'no_create': True}"/>
            </field>
        </field>
    </record>

</odoo>
