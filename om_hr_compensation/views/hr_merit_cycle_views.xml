<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_merit_cycle_line_view_list" model="ir.ui.view">
        <field name="name">hr.merit.cycle.line.view.list</field>
        <field name="model">hr.merit.cycle.line</field>
        <field name="arch" type="xml">
            <list string="Raises" editable="bottom" create="0" delete="0"
                  decoration-muted="state == 'refused'" decoration-success="state == 'approved'">
                <field name="cycle_state" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="cycle_id" optional="hide" readonly="1"/>
                <field name="employee_id" readonly="1"/>
                <field name="department_id" optional="show" readonly="1"/>
                <field name="manager_id" optional="hide" readonly="1"/>
                <field name="job_id" optional="hide" readonly="1"/>
                <field name="salary_grade_id" optional="show" readonly="1"/>
                <field name="current_wage" readonly="1"/>
                <field name="compa_ratio" optional="show"/>
                <field name="band_position" optional="show"/>
                <field name="proposed_percent" readonly="cycle_state != 'open' or state != 'proposed'"/>
                <field name="proposed_wage" readonly="cycle_state != 'open' or state != 'proposed'" sum="New Wages"/>
                <field name="increase" sum="Increase"/>
                <field name="new_compa_ratio" optional="hide"/>
                <field name="note" optional="show" readonly="cycle_state not in ('open', 'review')"/>
                <field name="state" widget="badge" readonly="1"/>
                <button name="action_approve" type="object" string="Approve" icon="check"
                        invisible="cycle_state != 'review' or state == 'approved'" groups="hr.group_hr_manager"/>
                <button name="action_refuse" type="object" string="Refuse" icon="close"
                        invisible="cycle_state != 'review' or state == 'refused'" groups="hr.group_hr_manager"/>
            </list>
        </field>
    </record>

    <record id="hr_merit_cycle_line_view_search" model="ir.ui.view">
        <field name="name">hr.merit.cycle.line.view.search</field>
        <field name="model">hr.merit.cycle.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="cycle_id"/>
                <filter name="open" string="Open for Proposals" domain="[('cycle_state', '=', 'open')]"/>
                <filter name="outside" string="Outside the Band" domain="[('band_position', 'in', ('below', 'above'))]"/>
                <group>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_cycle" string="Cycle" context="{'group_by': 'cycle_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hr_merit_cycle_line_action_team" model="ir.actions.act_window">
        <field name="name">Raises of My Team</field>
        <field name="res_model">hr.merit.cycle.line</field>
        <field name="view_mode">list</field>
        <field name="domain">[('manager_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No raise to propose</p>
            <p>When HR opens a merit cycle, you propose here the raise of each person of your team, within the
                budget of your department.</p>
        </field>
    </record>

    <record id="hr_merit_cycle_view_form" model="ir.ui.view">
        <field name="name">hr.merit.cycle.view.form</field>
        <field name="model">hr.merit.cycle</field>
        <field name="arch" type="xml">
            <form string="Merit Cycle">
                <header>
                    <button name="action_generate" string="Generate Employees" type="object" class="btn-primary"
                            invisible="state != 'draft'" groups="hr.group_hr_manager"/>
                    <button name="action_open" string="Open for Proposals" type="object" class="btn-primary"
                            invisible="state != 'draft' or not line_ids" groups="hr.group_hr_manager"/>
                    <button name="action_review" string="Close the Proposals" type="object" class="btn-primary"
                            invisible="state != 'open'" groups="hr.group_hr_manager"/>
                    <button name="action_approve_all" string="Approve All" type="object"
                            invisible="state != 'review'" groups="hr.group_hr_manager"/>
                    <button name="action_apply" string="Apply" type="object" class="btn-primary"
                            invisible="state != 'review'" groups="hr.group_hr_manager"
                            confirm="The approved raises become new contract versions from the effective date. Apply?"/>
                    <button name="action_back_to_open" string="Back to Proposals" type="object"
                            invisible="state != 'review'" groups="hr.group_hr_manager"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done', 'cancel')" groups="hr.group_hr_manager"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancel'" groups="hr.group_hr_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,review,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Merit Review 2027" readonly="state != 'draft'"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_effective" readonly="state in ('done', 'cancel')"/>
                            <field name="date_deadline" readonly="state in ('done', 'cancel')"/>
                            <field name="budget_percent" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="budget_total"/>
                            <field name="increase_total"/>
                            <field name="department_ids" widget="many2many_tags" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Budgets" name="budgets">
                            <field name="budget_ids" readonly="state in ('done', 'cancel')">
                                <list editable="bottom" create="0" delete="0"
                                      decoration-danger="remaining &lt; 0">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="department_id" readonly="1"/>
                                    <field name="manager_id"/>
                                    <field name="payroll" sum="Total"/>
                                    <field name="percent"/>
                                    <field name="budget" sum="Total"/>
                                    <field name="proposed" sum="Total"/>
                                    <field name="remaining" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Employees" name="lines">
                            <field name="line_ids" readonly="state in ('done', 'cancel')"
                                   context="{'list_view_ref': 'om_hr_compensation.hr_merit_cycle_line_view_list'}"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hr_merit_cycle_view_list" model="ir.ui.view">
        <field name="name">hr.merit.cycle.view.list</field>
        <field name="model">hr.merit.cycle</field>
        <field name="arch" type="xml">
            <list string="Merit Cycles">
                <field name="name"/>
                <field name="date_effective"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="budget_total"/>
                <field name="increase_total"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state in ('open', 'review')"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="hr_merit_cycle_action" model="ir.actions.act_window">
        <field name="name">Merit Cycles</field>
        <field name="res_model">hr.merit.cycle</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Plan the raises of the year</p>
            <p>Each department gets a budget; the managers propose the raises of their team, HR approves them and
                they become new contract versions.</p>
        </field>
    </record>

</odoo>
