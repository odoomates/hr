<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- the questions asked about the employee: change them, or make your own surveys -->
        <record id="survey_360" model="survey.survey">
            <field name="title">360 Feedback</field>
            <field name="access_mode">token</field>
            <field name="questions_layout">one_page</field>
            <field name="description" type="html"><p>Your answers help a colleague grow. The employee reads the
                answers of everyone combined, without the names; their manager and HR read who answered what.</p>
            </field>
        </record>

        <record id="survey_360_quality" model="survey.question">
            <field name="survey_id" ref="survey_360"/>
            <field name="sequence">10</field>
            <field name="title">Quality of the work</field>
            <field name="question_type">scale</field>
            <field name="scale_min">1</field>
            <field name="scale_max">5</field>
            <field name="scale_min_label">Poor</field>
            <field name="scale_max_label">Excellent</field>
            <field name="constr_mandatory" eval="True"/>
        </record>
        <record id="survey_360_collaboration" model="survey.question">
            <field name="survey_id" ref="survey_360"/>
            <field name="sequence">20</field>
            <field name="title">Working together</field>
            <field name="question_type">scale</field>
            <field name="scale_min">1</field>
            <field name="scale_max">5</field>
            <field name="scale_min_label">Poor</field>
            <field name="scale_max_label">Excellent</field>
            <field name="constr_mandatory" eval="True"/>
        </record>
        <record id="survey_360_communication" model="survey.question">
            <field name="survey_id" ref="survey_360"/>
            <field name="sequence">30</field>
            <field name="title">Communication</field>
            <field name="question_type">scale</field>
            <field name="scale_min">1</field>
            <field name="scale_max">5</field>
            <field name="scale_min_label">Poor</field>
            <field name="scale_max_label">Excellent</field>
            <field name="constr_mandatory" eval="True"/>
        </record>
        <record id="survey_360_keep" model="survey.question">
            <field name="survey_id" ref="survey_360"/>
            <field name="sequence">40</field>
            <field name="title">What should they keep doing?</field>
            <field name="question_type">text_box</field>
        </record>
        <record id="survey_360_improve" model="survey.question">
            <field name="survey_id" ref="survey_360"/>
            <field name="sequence">50</field>
            <field name="title">What could they do better?</field>
            <field name="question_type">text_box</field>
        </record>

    </data>
</odoo>
