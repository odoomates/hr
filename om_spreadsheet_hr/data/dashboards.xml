<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The HR dashboards, in the Human Resources section of the Dashboards app. The files are built by
         tools/build_dashboards.py. -->

    <record id="dashboard_workforce" model="spreadsheet.dashboard">
        <field name="name">Workforce</field>
        <field name="spreadsheet_binary_data" type="bytes" file="om_spreadsheet_hr/data/files/workforce_dashboard.json"/>
        <field name="main_data_model_ids" eval="[Command.set([ref('hr.model_hr_employee')])]"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard.spreadsheet_dashboard_group_hr"/>
        <field name="group_ids" eval="[Command.set([ref('hr.group_hr_user')])]"/>
        <field name="sequence">10</field>
        <field name="is_published">True</field>
    </record>

</odoo>
