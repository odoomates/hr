<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- a pulse of last month, closed: six answers from Research and Development -->
    <record id="demo_pulse" model="hr.pulse">
        <field name="name">Monthly Pulse</field>
        <field name="department_ids" eval="[(4, ref('hr.dep_rd'))]"/>
        <field name="date_start" eval="(DateTime.today() + relativedelta(months=-1)).strftime('%Y-%m-%d')"/>
        <field name="date_end" eval="(DateTime.today() + relativedelta(months=-1, days=7)).strftime('%Y-%m-%d')"/>
        <field name="state">running</field>
    </record>

    <record id="demo_answer_1" model="survey.user_input">
        <field name="survey_id" ref="survey_pulse"/>
        <field name="state">done</field>
    </record>
    <record id="demo_answer_1_enps" model="survey.user_input.line">
        <field name="user_input_id" ref="demo_answer_1"/>
        <field name="question_id" ref="survey_pulse_enps"/>
        <field name="answer_type">scale</field>
        <field name="value_scale">10</field>
    </record>
    <record id="demo_answer_1_workload" model="survey.user_input.line">
        <field name="user_input_id" ref="demo_answer_1"/>
        <field name="question_id" ref="survey_pulse_workload"/>
        <field name="answer_type">scale</field>
        <field name="value_scale">5</field>
    </record>
    <record id="demo_answer_1_comment" model="survey.user_input.line">
        <field name="user_input_id" ref="demo_answer_1"/>
        <field name="question_id" ref="survey_pulse_comment"/>
        <field name="answer_type">text_box</field>
        <field name="value_text_box">Great team, clear goals</field>
    </record>
    <record id="demo_ballot_1" model="hr.pulse.ballot">
        <field name="pulse_id" ref="demo_pulse"/>
        <field name="token_hash">924652900f09629d08aac14e683d04e94dcc53bdb5b03e6f16c376f1f0285b70</field>
        <field name="department_id" ref="hr.dep_rd"/>
