<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- the questions of a pulse: change them, or make your own surveys -->
        <record id="survey_pulse" model="survey.survey">
            <field name="title">Pulse Survey</field>
            <field name="access_mode">token</field>
            <field name="questions_layout">one_page</field>
            <field name="description" type="html"><p>Your answers are anonymous: Odoo never stores who answered
                what. The results are read by department, and only when at least five people answered.</p>
            </field>
        </record>

        <record id="survey_pulse_enps" model="survey.question">
            <field name="survey_id" ref="survey_pulse"/>
            <field name="sequence">10</field>
            <field name="title">How likely are you to recommend working here to a friend?</field>
            <field name="question_type">scale</field>
            <field name="scale_min">0</field>
            <field name="scale_max">10</field>
            <field name="scale_min_label">Not at all likely</field>
            <field name="scale_max_label">Extremely likely</field>
            <field name="constr_mandatory" eval="True"/>
        </record>
        <record id="survey_pulse_workload" model="survey.question">
            <field name="survey_id" ref="survey_pulse"/>
            <field name="sequence">20</field>
            <field name="title">My workload is manageable</field>
            <field name="question_type">scale</field>
            <field name="scale_min">1</field>
            <field name="scale_max">5</field>
            <field name="scale_min_label">Disagree</field>
            <field name="scale_max_label">Agree</field>
            <field name="constr_mandatory" eval="True"/>
        </record>
        <record id="survey_pulse_manager" model="survey.question">
            <field name="survey_id" ref="survey_pulse"/>
            <field name="sequence">30</field>
            <field name="title">My manager supports me</field>
            <field name="question_type">scale</field>
            <field name="scale_min">1</field>
            <field name="scale_max">5</field>
            <field name="scale_min_label">Disagree</field>
            <field name="scale_max_label">Agree</field>
            <field name="constr_mandatory" eval="True"/>
        </record>
        <record id="survey_pulse_growth" model="survey.question">
            <field name="survey_id" ref="survey_pulse"/>
            <field name="sequence">40</field>
            <field name="title">I can learn and grow here</field>
            <field name="question_type">scale</field>
            <field name="scale_min">1</field>
            <field name="scale_max">5</field>
            <field name="scale_min_label">Disagree</field>
            <field name="scale_max_label">Agree</field>
            <field name="constr_mandatory" eval="True"/>
        </record>
        <record id="survey_pulse_comment" model="survey.question">
            <field name="survey_id" ref="survey_pulse"/>
            <field name="sequence">50</field>
            <field name="title">Anything else you would like to share?</field>
            <field name="question_type">text_box</field>
        </record>

    </data>
</odoo>
