<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The biometric attendance dashboard, in the Human Resources section of the Dashboards app. The file is built
         by tools/build_dashboards.py. -->

    <record id="dashboard_biometric" model="spreadsheet.dashboard">
        <field name="name">Biometric Attendance</field>
        <field name="spreadsheet_binary_data" type="bytes" file="om_spreadsheet_hr_biometric/data/files/biometric_dashboard.json"/>
        <field name="main_data_model_ids" eval="[Command.set([ref('om_hr_biometric.model_hr_biometric_log')])]"/>
        <field name="dashboard_group_id" ref="spreadsheet_dashboard.spreadsheet_dashboard_group_hr"/>
        <field name="group_ids" eval="[Command.set([ref('hr_attendance.group_hr_attendance_user')])]"/>
        <field name="sequence">35</field>
        <field name="is_published">True</field>
    </record>

</odoo>
