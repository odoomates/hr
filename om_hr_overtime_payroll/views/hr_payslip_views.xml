<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_payslip_form_om_overtime" model="ir.ui.view">
        <field name="name">hr.payslip.form.om.overtime</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="om_hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <page name="worked_days" position="after">
                <page string="Overtime" name="om_overtime" invisible="not om_overtime_ids">
                    <field name="om_overtime_ids" readonly="1">
                        <list>
                            <field name="date"/>
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <field name="work_entry_type_id" string="Type"/>
                            <field name="time_rule_id" optional="show"/>
                            <field name="worked_hours" widget="float_time" sum="Total"/>
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>

</odoo>
