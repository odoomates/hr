<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="om_approval_request_view_form" model="ir.ui.view">
        <field name="name">approval.request.view.form</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <form string="Approval Request" create="0" edit="0" delete="0">
                <header>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"
                            invisible="not can_approve"/>
                    <button name="action_open_refuse" string="Refuse" type="object" invisible="not can_approve"/>
                    <button name="action_cancel" string="Withdraw" type="object"
                            invisible="state not in ('to_approve', 'approved')"/>
                    <field name="state" widget="statusbar" statusbar_visible="to_approve,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_record" type="object" class="oe_stat_button" icon="open_in_new">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Open</span>
                                <span class="o_stat_text"><field name="model_name"/></span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="document_name"/>
                            <field name="button_name" invisible="not method"/>
                            <field name="flow_id"/>
                        </group>
                        <group>
                            <field name="requester_id" widget="many2one_avatar_user"/>
                            <field name="create_date" string="Asked On"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="approval_step" invisible="state != 'to_approve'"/>
                            <field name="approver_user_ids" widget="many2many_avatar_user"
                                   invisible="state != 'to_approve'"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="name"/>
                            <field name="approver_user_ids" widget="many2many_avatar_user"/>
                            <field name="state" widget="badge" decoration-info="state == 'pending'"
                                   decoration-success="state == 'approved'" decoration-danger="state == 'refused'"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="date"/>
                            <field name="note"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="om_approval_request_view_list" model="ir.ui.view">
        <field name="name">approval.request.view.list</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <list string="Approval Requests" create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="create_date" string="Asked On"/>
                <field name="model_name"/>
                <field name="document_name"/>
                <field name="button_name" optional="show"/>
                <field name="requester_id" widget="many2one_avatar_user"/>
                <field name="approval_step" optional="show"/>
                <field name="approver_user_ids" widget="many2many_avatar_user" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'to_approve'"
                       decoration-success="state in ('approved', 'done')" decoration-danger="state == 'refused'"/>
            </list>
        </field>
    </record>

    <record id="om_approval_request_view_search" model="ir.ui.view">
        <field name="name">approval.request.view.search</field>
        <field name="model">approval.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="requester_id"/>
                <field name="res_model"/>
                <filter name="to_approve_by_me" string="To Approve by Me" domain="[('approver_user_ids', 'in', uid)]"/>
                <filter name="my_requests" string="My Requests" domain="[('requester_id', '=', uid)]"/>
                <separator/>
                <filter name="to_approve" string="To Approve" domain="[('state', '=', 'to_approve')]"/>
                <filter name="approved" string="Approved" domain="[('state', 'in', ('approved', 'done'))]"/>
                <filter name="refused" string="Refused" domain="[('state', '=', 'refused')]"/>
                <group>
                    <filter name="group_model" string="Kind of Record" context="{'group_by': 'res_model'}"/>
                    <filter name="group_requester" string="Requested By" context="{'group_by': 'requester_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="om_approval_request_action_to_approve" model="ir.actions.act_window">
        <field name="name">To Approve</field>
        <field name="res_model">approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_approve_by_me': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing to approve</p>
            <p>What waits for your approval, from every app, shows here.</p>
        </field>
    </record>

    <record id="om_approval_request_action_my" model="ir.actions.act_window">
        <field name="name">My Requests</field>
        <field name="res_model">approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_requests': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No approval asked</p>
            <p>A button needing an approval asks for it when you click it. Follow your requests here.</p>
        </field>
    </record>

    <record id="om_approval_request_action" model="ir.actions.act_window">
        <field name="name">All Requests</field>
        <field name="res_model">approval.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_approve': 1}</field>
    </record>

</odoo>
