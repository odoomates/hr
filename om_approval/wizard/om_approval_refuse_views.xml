<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="om_approval_refuse_view_form" model="ir.ui.view">
        <field name="name">approval.refuse.view.form</field>
        <field name="model">approval.refuse</field>
        <field name="arch" type="xml">
            <form string="Refuse">
                <field name="request_id" invisible="1"/>
                <field name="reason" placeholder="Why is it refused? The requester reads it."/>
                <footer>
                    <button name="action_refuse" string="Refuse" type="object" class="btn-primary"/>
                    <button string="Discard" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
