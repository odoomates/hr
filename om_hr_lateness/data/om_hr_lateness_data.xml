<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_compute_lateness" model="ir.cron">
        <field name="name">Lateness: late arrivals and early departures of the last days</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="state">code</field>
        <field name="code">model._cron_om_compute_lateness()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <data noupdate="1">

        <record id="policy_standard" model="om.hr.lateness.policy">
            <field name="name">Standard</field>
            <field name="company_id" eval="False"/>
            <field name="grace_in">10</field>
            <field name="grace_out">10</field>
            <field name="description">Beyond 10 minutes, the time late, or left early, is taken off at the hourly wage.</field>
        </record>

        <record id="policy_standard_minutes" model="om.hr.lateness.policy.line">
            <field name="policy_id" ref="policy_standard"/>
            <field name="minutes_from">0</field>
            <field name="occurrence">1</field>
            <field name="penalty">minutes</field>
            <field name="factor">1</field>
        </record>

    </data>
</odoo>
