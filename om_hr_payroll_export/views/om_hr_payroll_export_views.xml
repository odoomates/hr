<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="om_hr_payroll_export_wizard_view_form" model="ir.ui.view">
        <field name="name">om.hr.payroll.export.wizard.view.form</field>
        <field name="model">om.hr.payroll.export.wizard</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="om_file_layout.om_file_export_wizard_view_form"/>
        <field name="arch" type="xml">
            <form position="attributes">
                <attribute name="string">Export Bank File</attribute>
            </form>
        </field>
    </record>

    <record id="view_hr_payslip_form_om_export" model="ir.ui.view">
        <field name="name">hr.payslip.form.om.export</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="om_hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_om_export_bank_file" string="Export Bank File" type="object"
                        invisible="state != 'done' or credit_note" groups="om_hr_payroll.group_hr_payroll_user"/>
            </xpath>
            <field name="credit_note" position="after">
                <field name="om_exported" invisible="not om_exported"/>
                <field name="om_file_export_ids" widget="many2many_tags" invisible="not om_file_export_ids"/>
            </field>
        </field>
    </record>

    <record id="view_hr_payslip_tree_om_export" model="ir.ui.view">
        <field name="name">hr.payslip.list.om.export</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="om_hr_payroll.view_hr_payslip_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="om_exported" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="hr_payslip_run_form_om_export" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.om.export</field>
        <field name="model">hr.payslip.run</field>
        <field name="inherit_id" ref="om_hr_payroll.hr_payslip_run_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_om_export_bank_file" string="Export Bank File" type="object"
                        invisible="state == 'draft'" groups="om_hr_payroll.group_hr_payroll_user"/>
            </xpath>
        </field>
    </record>

    <record id="om_file_layout_action_payroll" model="ir.actions.act_window">
        <field name="name">Bank File Layouts</field>
        <field name="res_model">om.file.layout</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('model', '=', 'hr.payslip')]</field>
        <field name="context" eval="{'default_model_id': ref('om_hr_payroll.model_hr_payslip')}"/>
    </record>

    <record id="om_file_export_action_payroll" model="ir.actions.act_window">
        <field name="name">Bank Files</field>
        <field name="res_model">om.file.export</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('res_model', '=', 'hr.payslip')]</field>
    </record>

</odoo>
