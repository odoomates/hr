<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Templates: the planning templates with the fields of the shifts -->
    <record id="om_hr_shift_planning_template_view_list" model="ir.ui.view">
        <field name="name">om.planning.template.list.om.shift</field>
        <field name="model">om.planning.template</field>
        <field name="inherit_id" ref="om_planning.om_planning_template_view_list"/>
        <field name="arch" type="xml">
            <field name="role_id" position="after">
                <field name="department_ids" widget="many2many_tags" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="allowance" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="om_hr_shift_planning_template_view_form" model="ir.ui.view">
        <field name="name">om.planning.template.form.om.shift</field>
        <field name="model">om.planning.template</field>
        <field name="inherit_id" ref="om_planning.om_planning_template_view_form"/>
        <field name="arch" type="xml">
            <field name="break_hours" position="after">
                <field name="break_from" widget="float_time" invisible="not break_hours"/>
            </field>
            <field name="role_id" position="after">
                <field name="department_ids" widget="many2many_tags"/>
                <field name="job_ids" widget="many2many_tags"/>
                <field name="work_entry_type_id"/>
                <field name="currency_id" invisible="1"/>
                <field name="allowance"/>
            </field>
        </field>
    </record>

    <record id="om_hr_shift_template_action" model="ir.actions.act_window">
        <field name="name">Shift Templates</field>
        <field name="res_model">om.planning.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="False"/>
        <field name="context">{}</field>
    </record>

    <!-- Rotations -->
    <record id="om_hr_shift_planning_rotation_view_list" model="ir.ui.view">
        <field name="name">om.planning.rotation.list.om.shift</field>
        <field name="model">om.planning.rotation</field>
        <field name="inherit_id" ref="om_planning.om_planning_rotation_view_list"/>
        <field name="arch" type="xml">
            <field name="cycle_length" position="after">
                <field name="pattern"/>
            </field>
        </field>
    </record>

    <record id="om_hr_shift_planning_rotation_view_form" model="ir.ui.view">
        <field name="name">om.planning.rotation.form.om.shift</field>
        <field name="model">om.planning.rotation</field>
        <field name="inherit_id" ref="om_planning.om_planning_rotation_view_form"/>
        <field name="arch" type="xml">
            <field name="cycle_length" position="after">
                <field name="pattern"/>
            </field>
        </field>
    </record>

    <record id="om_hr_shift_rotation_action" model="ir.actions.act_window">
        <field name="name">Shift Rotations</field>
        <field name="res_model">om.planning.rotation</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="False"/>
        <field name="context">{}</field>
    </record>

    <record id="om_hr_shift_rotation_wizard_action" model="ir.actions.act_window">
        <field name="name">Apply a Rotation</field>
        <field name="res_model">om.planning.rotation.apply</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="domain" eval="False"/>
        <field name="context">{}</field>
    </record>

    <!-- Shifts: the slots of the planning -->
    <record id="om_hr_shift_slot_view_form" model="ir.ui.view">
        <field name="name">om.planning.slot.form.om.shift</field>
        <field name="model">om.planning.slot</field>
        <field name="inherit_id" ref="om_planning.om_planning_slot_view_form"/>
        <field name="arch" type="xml">
            <field name="break_hours" position="after">
                <field name="break_from" widget="float_time" invisible="not break_hours"/>
            </field>
            <field name="name" position="after">
                <field name="department_id" invisible="not is_open" options="{'no_create': True}"/>
            </field>
        </field>
    </record>

    <record id="om_hr_shift_slot_view_list" model="ir.ui.view">
        <field name="name">om.planning.slot.list.om.shift</field>
        <field name="model">om.planning.slot</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <list string="Shifts" multi_edit="1" decoration-danger="conflict_count &gt; 0"
                  decoration-muted="state == 'draft'">
                <field name="shift_date"/>
                <field name="resource_ids" widget="many2many_tags" string="Employees"/>
                <field name="department_id" optional="show"/>
                <field name="template_id"/>
                <field name="start_datetime"/>
                <field name="end_datetime"/>
                <field name="allocated_hours" widget="float_time" sum="Total"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="conflict_count" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'published'"/>
                <button name="action_request_claim" type="object" string="Claim" icon="back_hand"
                        invisible="not is_open or state != 'published'"/>
                <field name="is_open" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="om_hr_shift_slot_view_search" model="ir.ui.view">
        <field name="name">om.planning.slot.search.om.shift</field>
        <field name="model">om.planning.slot</field>
        <field name="inherit_id" ref="om_planning.om_planning_slot_view_search"/>
        <field name="arch" type="xml">
            <field name="role_id" position="after">
                <field name="template_id"/>
            </field>
            <filter name="group_role" position="before">
                <filter name="group_shift_date" string="Week" context="{'group_by': 'shift_date:week'}"/>
                <filter name="group_template" string="Shift Template" context="{'group_by': 'template_id'}"/>
            </filter>
        </field>
    </record>

    <record id="om_hr_shift_action_schedule" model="ir.actions.act_window">
        <field name="name">Roster</field>
        <field name="res_model">om.planning.slot</field>
        <field name="view_mode">gantt,calendar,list,form,pivot</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'gantt', 'view_id': ref('om_planning.om_planning_slot_view_gantt')}),
            Command.create({'view_mode': 'calendar', 'view_id': ref('om_planning.om_planning_slot_view_calendar')}),
            Command.create({'view_mode': 'list', 'view_id': ref('om_hr_shift_slot_view_list')})]"/>
        <field name="domain">[('source_ref', '=', False)]</field>
        <field name="context">{'om_planning_label': 'role'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Plan the shifts on the roster</p>
            <p>Published, a shift is the working schedule of the employee: time off, attendances, overtime and
                payroll follow it.</p>
        </field>
    </record>

    <record id="om_hr_shift_action" model="ir.actions.act_window">
        <field name="name">Shifts</field>
        <field name="res_model">om.planning.slot</field>
        <field name="view_mode">list,calendar,pivot,form</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('om_hr_shift_slot_view_list')})]"/>
        <field name="domain">[('source_ref', '=', False)]</field>
        <field name="context">{'search_default_future': 1, 'om_planning_label': 'role'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Plan the shifts on the Roster</p>
            <p>Published, a shift is the working schedule of the employee: time off, attendances, overtime and
                payroll follow it.</p>
        </field>
    </record>

    <record id="om_hr_shift_action_my" model="ir.actions.act_window">
        <field name="name">My Shifts</field>
        <field name="res_model">om.planning.slot</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('om_hr_shift_slot_view_list')})]"/>
        <field name="domain">[('resource_ids.user_id', '=', uid), ('state', '=', 'published')]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False, 'om_planning_label': 'role'}</field>
        <field name="help" eval="False"/>
    </record>

    <record id="om_hr_shift_action_open" model="ir.actions.act_window">
        <field name="name">Open Shifts</field>
        <field name="res_model">om.planning.slot</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[Command.clear(),
            Command.create({'view_mode': 'list', 'view_id': ref('om_hr_shift_slot_view_list')})]"/>
        <field name="domain">[('is_open', '=', True), ('state', '=', 'published')]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False, 'search_default_future': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No open shift</p>
            <p>The shifts no one works yet show here: claim one, your manager approves.</p>
        </field>
    </record>

    <!-- Unavailability: time off of the resource of the employee -->
    <record id="om_hr_shift_unavailability_view_list" model="ir.ui.view">
        <field name="name">resource.calendar.leaves.list.om.shift</field>
        <field name="model">resource.calendar.leaves</field>
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <list string="Unavailability" editable="bottom">
                <field name="resource_id" string="Employee" required="1" options="{'no_create': True}"
                       domain="[('employee_id', '!=', False)]"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="name" string="Reason"/>
                <field name="shift_unavailability" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="om_hr_shift_unavailability_action" model="ir.actions.act_window">
        <field name="name">Unavailability</field>
        <field name="res_model">resource.calendar.leaves</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="om_hr_shift_unavailability_view_list"/>
        <field name="domain">[('shift_unavailability', '=', True)]</field>
        <field name="context">{'default_shift_unavailability': True}</field>
    </record>

    <record id="om_hr_shift_unavailability_action_my" model="ir.actions.act_window">
        <field name="name">My Unavailability</field>
        <field name="res_model">resource.calendar.leaves</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="om_hr_shift_unavailability_view_list"/>
        <field name="domain">[('shift_unavailability', '=', True), ('resource_id.user_id', '=', uid)]</field>
        <field name="context">{'default_shift_unavailability': True, 'om_hr_shift_my_unavailability': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Tell your planner the days you cannot work</p>
            <p>They show on the roster.</p>
        </field>
    </record>

    <!-- Requests -->
    <record id="om_hr_shift_request_view_list" model="ir.ui.view">
        <field name="name">om.planning.request.list.om.shift</field>
        <field name="model">om.planning.request</field>
        <field name="inherit_id" ref="om_planning.om_planning_request_view_list"/>
        <field name="arch" type="xml">
            <field name="target_resource_id" position="after">
                <field name="target_slot_id" optional="hide"/>
            </field>
            <field name="state" position="attributes">
                <attribute name="decoration-info">state in ('draft', 'to_accept')</attribute>
            </field>
        </field>
    </record>

    <record id="om_hr_shift_request_view_form" model="ir.ui.view">
        <field name="name">om.planning.request.form.om.shift</field>
        <field name="model">om.planning.request</field>
        <field name="inherit_id" ref="om_planning.om_planning_request_view_form"/>
        <field name="arch" type="xml">
            <button name="action_approve" position="before">
                <button name="action_submit" type="object" string="Submit" class="btn-primary"
                        invisible="state != 'draft'"/>
                <button name="action_accept" type="object" string="Accept" class="btn-primary"
                        invisible="not can_accept"/>
                <button name="action_decline" type="object" string="Decline" invisible="not can_accept"/>
            </button>
            <button name="action_cancel" position="attributes">
                <attribute name="invisible">state not in ('draft', 'to_accept', 'pending')</attribute>
            </button>
            <field name="state" position="attributes">
                <attribute name="statusbar_visible">to_accept,pending,approved</attribute>
            </field>
            <field name="can_approve" position="after">
                <field name="can_accept" invisible="1"/>
            </field>
            <field name="target_resource_id" position="after">
                <field name="target_slot_id" invisible="not target_slot_id" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="om_hr_shift_request_view_form_switch" model="ir.ui.view">
        <field name="name">om.planning.request.form.switch.om.shift</field>
        <field name="model">om.planning.request</field>
        <field name="inherit_id" ref="om_planning.om_planning_request_view_form_switch"/>
        <field name="arch" type="xml">
            <field name="target_resource_id" position="after">
                <field name="target_slot_id" groups="om_hr_shift.group_shift_planner" options="{'no_create': True}"
                       domain="[('state', '=', 'published'), ('resource_ids', 'in', [target_resource_id]),
                                ('id', '!=', slot_id)]"
                       invisible="not target_resource_id"/>
            </field>
        </field>
    </record>

    <record id="om_hr_shift_request_action" model="ir.actions.act_window">
        <field name="name">Shift Requests</field>
        <field name="res_model">om.planning.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain" eval="False"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No shift request</p>
            <p>The claims of open shifts and the swaps between colleagues show here for approval.</p>
        </field>
    </record>

    <record id="om_hr_shift_request_action_my" model="ir.actions.act_window">
        <field name="name">My Shift Requests</field>
        <field name="res_model">om.planning.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('resource_id.user_id', '=', uid), ('target_resource_id.user_id', '=', uid)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Claim an open shift, or swap one with a colleague</p>
            <p>The colleague accepts the swap, then your manager approves.</p>
        </field>
    </record>

    <!-- Rostering -->
    <record id="om_hr_shift_rostering_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.shift.rostering.wizard.view.form</field>
        <field name="model">hr.shift.rostering.wizard</field>
        <field name="arch" type="xml">
            <form string="Rostering">
                <div class="text-muted mb-3" invisible="mode != 'start'">
                    From this day, the published shifts are the working schedule of the employees: a new version of
                    their contract gets a schedule of their own. The days before keep the schedule they had.
                </div>
                <group>
                    <field name="mode" widget="radio" options="{'horizontal': true}"/>
                    <field name="employee_ids" widget="many2many_tags_avatar"/>
                    <field name="date"/>
                    <field name="calendar_id" invisible="mode != 'stop'" required="mode == 'stop'"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Discard" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="om_hr_shift_rostering_wizard_action" model="ir.actions.act_window">
        <field name="name">Rostering</field>
        <field name="res_model">hr.shift.rostering.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="context">{'default_employee_ids': active_ids}</field>
        <field name="group_ids" eval="[(4, ref('om_hr_shift.group_shift_planner'))]"/>
    </record>

    <!-- Employee -->
    <record id="hr_employee_view_form_om_shift" model="ir.ui.view">
        <field name="name">hr.employee.view.form.om.shift</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_rostering" type="object" string="Rostering"
                        groups="om_hr_shift.group_shift_planner"/>
            </xpath>
            <field name="resource_calendar_id" position="after">
                <field name="roster_date_start" invisible="not roster_date_start"/>
            </field>
        </field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_om_hr_shift_root" name="Shifts" sequence="76"
              web_icon="om_hr_shift,static/description/icon.png"
              groups="om_hr_shift.group_shift_planner"/>
    <menuitem id="menu_om_hr_shift_roster" action="om_hr_shift_action_schedule" parent="menu_om_hr_shift_root"
              sequence="10"/>
    <menuitem id="menu_om_hr_shift_shifts" action="om_hr_shift_action" parent="menu_om_hr_shift_root"
              sequence="20"/>
    <menuitem id="menu_om_hr_shift_requests" action="om_hr_shift_request_action" parent="menu_om_hr_shift_root"
              sequence="30"/>
    <menuitem id="menu_om_hr_shift_unavailability" action="om_hr_shift_unavailability_action"
              parent="menu_om_hr_shift_root" sequence="40"/>
    <menuitem id="menu_om_hr_shift_rotation_apply" action="om_hr_shift_rotation_wizard_action"
              parent="menu_om_hr_shift_root" sequence="50"/>
    <menuitem id="menu_om_hr_shift_configuration" name="Configuration" parent="menu_om_hr_shift_root"
              sequence="90" groups="om_hr_shift.group_shift_manager"/>
    <menuitem id="menu_om_hr_shift_settings" action="om_planning.action_om_planning_settings"
              name="Settings" parent="menu_om_hr_shift_configuration" sequence="5" groups="base.group_system"/>
    <menuitem id="menu_om_hr_shift_template" action="om_hr_shift_template_action"
              parent="menu_om_hr_shift_configuration" sequence="10"/>
    <menuitem id="menu_om_hr_shift_rotation" action="om_hr_shift_rotation_action"
              parent="menu_om_hr_shift_configuration" sequence="20"/>

    <menuitem id="menu_my_hr_shifts" action="om_hr_shift_action_my" parent="om_hr_base.menu_my_hr" sequence="12"/>
    <menuitem id="menu_my_hr_open_shifts" action="om_hr_shift_action_open" parent="om_hr_base.menu_my_hr"
              sequence="13"/>
    <menuitem id="menu_my_hr_shift_requests" action="om_hr_shift_request_action_my" parent="om_hr_base.menu_my_hr"
              sequence="14"/>
    <menuitem id="menu_my_hr_unavailability" action="om_hr_shift_unavailability_action_my"
              parent="om_hr_base.menu_my_hr" sequence="15"/>

</odoo>
