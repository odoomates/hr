<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="privilege_shift" model="res.groups.privilege">
            <field name="name">Shifts</field>
        </record>

        <record id="group_shift_planner" model="res.groups">
            <field name="name">Planner</field>
            <field name="privilege_id" ref="privilege_shift"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Plans and publishes the shifts, e.g. a team leader.</field>
        </record>

        <record id="group_shift_manager" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_shift"/>
            <field name="implied_ids" eval="[(4, ref('om_hr_shift.group_shift_planner'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Sets the shift templates, the rotations and the rules of the roster.</field>
        </record>

        <!-- the HR officers plan the shifts too -->
        <record id="hr.group_hr_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('om_hr_shift.group_shift_planner'))]"/>
        </record>

    </data>
</odoo>
