<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="print_template_handover" model="om.print.template">
            <field name="name">Asset Handover Form</field>
            <field name="model_id" ref="om_hr_asset.model_om_hr_asset_assignment"/>
            <field name="code">ASSET/%(year)s/</field>
            <field name="subject">Asset Handover Form</field>
            <field name="addressee" eval="False"/>
            <field name="signatory_title">Issued by</field>
            <field name="body_html" type="html">
<div>
    <p>I, <strong t-out="object.employee_id.name or ''"/>, acknowledge receiving from
        <t t-out="object.company_id.name or ''"/> on <t t-out="format_date(object.date_from) or ''"/>
        the following asset:</p>
    <table class="table table-sm table-bordered">
        <tr><th>Asset</th><td t-out="object.equipment_id.name or ''"/></tr>
        <tr><th>Category</th><td t-out="object.category_id.name or ''"/></tr>
        <tr><th>Serial Number</th><td t-out="object.serial_no or ''"/></tr>
        <tr><th>Model</th><td t-out="object.equipment_id.model or ''"/></tr>
        <tr><th>Condition</th><td t-out="object.condition_out_label or ''"/></tr>
    </table>
    <p>I will use it for my work, take care of it, and return it in the same condition, fair wear and tear
        excepted, when asked or when I leave the company. I may be charged for it if it is lost or damaged
        through my negligence.</p>
    <p><br/></p>
    <p>Employee signature: ______________________ &#160;&#160;&#160; Date: ______________</p>
</div>
            </field>
        </record>

    </data>
</odoo>
