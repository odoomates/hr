<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_hr" inherit_id="om_hr_portal.portal_my_hr" name="My HR: Announcements">
        <xpath expr="//div[@id='om_hr_cards']" position="inside">
            <div class="col" style="order: 0;">
                <t t-call="om_hr_portal.portal_my_hr_card" url="'/my/hr/announcements'" icon="'campaign'"
                   title.translate="Announcements" text.translate="What the company and your department tell you"/>
            </div>
        </xpath>
    </template>

    <template id="portal_my_announcements" name="My Announcements">
        <t t-call="portal.portal_layout">
            <div t-if="not lines" class="alert alert-info">No announcement for you.</div>
            <div class="list-group mb-4">
                <a t-foreach="lines" t-as="line" t-attf-href="/my/hr/announcements/#{line.announcement_id.id}"
                   class="list-group-item list-group-item-action d-flex justify-content-between align-items-center o_om_portal_announcement"
                   t-attf-style="#{'border-left: 4px solid var(--bs-warning);' if line.announcement_id.pinned else ''}">
                    <span>
                        <span t-attf-class="#{'fw-bold' if not line.read_date else ''}" t-out="line.announcement_id.name"/>
                        <div class="small text-muted" t-out="line.announcement_id.date_start.strftime('%d %b %Y')"/>
                    </span>
                    <span>
                        <span t-if="line.announcement_id.pinned" class="badge text-bg-warning">Important</span>
                        <span t-if="not line.read_date" class="badge text-bg-info">Unread</span>
                        <span t-if="line.announcement_id.requires_ack and not line.ack_date"
                              class="badge text-bg-danger">To Acknowledge</span>
                        <span t-if="line.ack_date" class="badge text-bg-success">Acknowledged</span>
                    </span>
                </a>
            </div>
        </t>
    </template>

    <template id="portal_my_announcement" name="My Announcement">
        <t t-call="portal.portal_layout">
            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0"><t t-out="announcement.name"/>
                        <span t-if="announcement.pinned" class="badge text-bg-warning ms-2">Important</span></h4>
                    <div class="small text-muted" t-out="announcement.date_start.strftime('%d %b %Y')"/>
                </div>
                <div class="card-body">
                    <div t-field="announcement.body"/>
                    <div t-if="announcement.attachment_ids" class="mt-3">
                        <a t-foreach="announcement.attachment_ids" t-as="attachment"
                           t-attf-href="/web/content/#{attachment.id}?download=true&amp;access_token=#{attachment.generate_access_token()[0]}"
                           class="btn btn-sm btn-secondary me-2 mb-2">
                            <t t-out="attachment.name"/>
                        </a>
                    </div>
                </div>
                <div t-if="announcement.requires_ack" class="card-footer">
                    <form t-if="not line.ack_date" t-attf-action="/my/hr/announcements/#{announcement.id}/acknowledge"
                          method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <button type="submit" class="btn btn-primary">I Have Read and Understood</button>
                    </form>
                    <span t-else="" class="text-success">Acknowledged on <span t-field="line.ack_date"/></span>
                </div>
            </div>
        </t>
    </template>
</odoo>
