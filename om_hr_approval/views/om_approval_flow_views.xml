<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="om_approval_flow_action_hr" model="ir.actions.act_window">
        <field name="name">Approval Flows</field>
        <field name="res_model">om.approval.flow</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('model', '=like', 'om.hr.%')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create an approval flow</p>
            <p>Decide who approves the HR documents, such as the requests and the loans, and in which order.</p>
        </field>
    </record>

</odoo>
