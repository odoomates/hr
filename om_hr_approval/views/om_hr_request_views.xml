<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="om_hr_request_view_form" model="ir.ui.view">
        <field name="name">om.hr.request.view.form</field>
        <field name="model">om.hr.request</field>
        <field name="arch" type="xml">
            <form string="HR Request">
                <header>
                    <button name="action_approval_submit" string="Submit" type="object" class="btn-primary"
                            invisible="approval_state != 'draft'"/>
                    <button name="action_approval_approve" string="Approve" type="object" class="btn-primary"
                            invisible="not can_approve"/>
                    <button name="action_approval_open_refuse" string="Refuse" type="object"
                            invisible="not can_approve"/>
                    <button name="action_approval_reset" string="Back to Draft" type="object"
                            invisible="approval_state not in ('to_approve', 'refused', 'cancel')"/>
                    <button name="action_approval_cancel" string="Cancel" type="object"
                            invisible="approval_state not in ('draft', 'to_approve')"/>
                    <field name="approval_state" widget="statusbar" statusbar_visible="draft,to_approve,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id" readonly="approval_state != 'draft'"/>
                            <field name="category_id" readonly="approval_state != 'draft'"
                                   options="{'no_create': True}"/>
                            <field name="date" readonly="approval_state != 'draft'"/>
                        </group>
                        <group>
                            <field name="department_id"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="approval_state != 'draft'"/>
                            <field name="approval_step" invisible="approval_state != 'to_approve'"/>
                            <field name="approver_user_ids" widget="many2many_avatar_user"
                                   invisible="approval_state != 'to_approve'"/>
                        </group>
                    </group>
                    <div class="text-muted" invisible="not category_description or approval_state != 'draft'">
                        <field name="category_description"/>
                    </div>
                    <notebook>
                        <page string="Details" name="details">
                            <field name="description" placeholder="What do you need?"
                                   readonly="approval_state != 'draft'"/>
                        </page>
                        <page string="Approvals" name="approvals" invisible="not approval_line_ids">
                            <field name="approval_line_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="approver_user_ids" widget="many2many_avatar_user"/>
                                    <field name="state" widget="badge" decoration-info="state == 'pending'"
                                           decoration-success="state == 'approved'"
                                           decoration-danger="state == 'refused'"/>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                    <field name="date"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="om_hr_request_view_list" model="ir.ui.view">
        <field name="name">om.hr.request.view.list</field>
        <field name="model">om.hr.request</field>
        <field name="arch" type="xml">
            <list string="HR Requests">
                <field name="name"/>
                <field name="date"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="category_id"/>
                <field name="department_id" optional="hide"/>
                <field name="approval_step" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="approval_state" widget="badge" decoration-info="approval_state == 'to_approve'"
                       decoration-success="approval_state == 'approved'"
                       decoration-danger="approval_state == 'refused'"/>
            </list>
        </field>
    </record>

    <record id="om_hr_request_view_search" model="ir.ui.view">
        <field name="name">om.hr.request.view.search</field>
        <field name="model">om.hr.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <field name="category_id"/>
                <filter name="my_requests" string="My Requests" domain="[('employee_id.user_id', '=', uid)]"/>
                <filter name="to_approve_by_me" string="To Approve by Me" domain="[('approver_user_ids', 'in', uid)]"/>
                <separator/>
                <filter name="to_approve" string="To Approve" domain="[('approval_state', '=', 'to_approve')]"/>
                <filter name="approved" string="Approved" domain="[('approval_state', '=', 'approved')]"/>
                <filter name="refused" string="Refused" domain="[('approval_state', '=', 'refused')]"/>
                <group>
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'approval_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="om_hr_request_action_my" model="ir.actions.act_window">
        <field name="name">My Requests</field>
        <field name="res_model">om.hr.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Ask HR for something</p>
            <p>A document, a change of your details or anything else: your request goes to your manager, then to
                HR.</p>
        </field>
    </record>

    <record id="om_hr_request_action_to_approve" model="ir.actions.act_window">
        <field name="name">To Approve</field>
        <field name="res_model">om.hr.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_approve_by_me': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing to approve</p>
            <p>The HR requests waiting for your approval show here.</p>
        </field>
    </record>

    <record id="om_hr_request_action" model="ir.actions.act_window">
        <field name="name">All Requests</field>
        <field name="res_model">om.hr.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_to_approve': 1}</field>
    </record>

    <record id="om_hr_request_category_view_list" model="ir.ui.view">
        <field name="name">om.hr.request.category.view.list</field>
        <field name="model">om.hr.request.category</field>
        <field name="arch" type="xml">
            <list string="Request Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="om_hr_request_category_action" model="ir.actions.act_window">
        <field name="name">Request Categories</field>
        <field name="res_model">om.hr.request.category</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
