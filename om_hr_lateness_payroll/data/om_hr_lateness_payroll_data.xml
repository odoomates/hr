<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_lateness_penalties" model="ir.cron">
        <field name="name">Lateness: penalties of the month before, as payroll adjustments</field>
        <field name="model_id" ref="om_hr_lateness.model_hr_lateness"/>
        <field name="state">code</field>
        <field name="code">model._cron_lateness_penalties()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>

    <data noupdate="1">
        <record id="adjustment_type_lateness" model="hr.payroll.adjustment.type">
            <field name="name">Lateness</field>
            <field name="code">ADJ_LATE</field>
            <field name="sequence">45</field>
            <field name="kind">deduction</field>
            <field name="category_id" ref="om_hr_payroll.DED"/>
            <field name="require_approval" eval="False"/>
            <field name="settle_at_exit" eval="True"/>
            <field name="description">The penalties of the late arrivals and early departures of a month, from the
lateness policy.</field>
        </record>
    </data>
</odoo>
