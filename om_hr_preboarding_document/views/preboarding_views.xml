<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_preboarding_step_view_form" model="ir.ui.view">
        <field name="name">hr.preboarding.step.view.form.document</field>
        <field name="model">hr.preboarding.step</field>
        <field name="inherit_id" ref="om_hr_preboarding.hr_preboarding_step_view_form"/>
        <field name="arch" type="xml">
            <field name="kind" position="after">
                <field name="document_type_id" invisible="kind != 'document'" required="kind == 'document'"
                       options="{'no_create': True}"/>
            </field>
        </field>
    </record>

    <template id="portal_my_welcome_step" inherit_id="om_hr_preboarding.portal_my_welcome_step"
              name="Pre-boarding Step: Document">
        <xpath expr="//div[@id='preboarding_auto_step']" position="inside">
            <a t-if="line.kind == 'document' and line.document_id" href="/my/hr/documents" class="btn btn-primary">
                Upload Your <t t-out="line.document_type_id.name"/>
            </a>
        </xpath>
    </template>

</odoo>
