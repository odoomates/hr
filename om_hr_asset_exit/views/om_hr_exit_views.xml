<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="om_hr_exit_view_form_om_asset" model="ir.ui.view">
        <field name="name">om.hr.exit.view.form.om.asset</field>
        <field name="model">om.hr.exit</field>
        <field name="inherit_id" ref="om_hr_exit.om_hr_exit_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='clearance_ids']/list/field[@name='name']" position="after">
                <field name="asset_assignment_id" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='clearance_ids']/list/button[@name='action_clear']" position="attributes">
                <attribute name="invisible">state != 'pending' or asset_assignment_id</attribute>
            </xpath>
            <xpath expr="//field[@name='clearance_ids']/list/button[@name='action_not_needed']" position="attributes">
                <attribute name="invisible">state != 'pending' or asset_assignment_id</attribute>
            </xpath>
        </field>
    </record>

</odoo>
